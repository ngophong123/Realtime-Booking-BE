datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum SeatType {
  STANDARD
  VIP
  COUPLE
}

enum BookingStatus {
  PENDING
  HOLDING
  PAID
  CONFIRMED
  CANCELLED
  EXPIRED
  FAILED
  REFUNDED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  name          String
  role          Role           @default(USER)
  bookings      Booking[]
  seatHolds     SeatHold[]
  vouchers      Voucher[]
  notifications Notification[]
  paymentLogs   PaymentLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Movie {
  id          String     @id @default(uuid())
  title       String 
  description String?
  duration    Int        // Thời lượng phim (phút)
  releaseDate DateTime
  posterUrl   String?
  status      String     @default("COMING_SOON") // NOW_SHOWING | COMING_SOON
  showtimes   Showtime[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Room {
  id        String     @id @default(uuid())
  name      String     @unique
  type      String     @default("STANDARD") // STANDARD | IMAX | COUPLE | VIP
  rows      Int  
  columns   Int
  seats     Seat[]
  showtimes Showtime[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Seat {
  id           String        @id @default(uuid())
  roomId       String 
  room         Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  row          String        // Hàng ghế
  column       Int           // Số ghế
  label        String        // Tên ghế kết hợp
  type         SeatType      @default(STANDARD) // Loại ghế
  bookingSeats BookingSeat[]
  seatHolds    SeatHold[]  

  @@unique([roomId, row, column])
}

model Showtime {
  id        String     @id @default(uuid())
  movieId   String
  movie     Movie      @relation(fields: [movieId], references: [id], onDelete: Cascade)
  roomId    String
  room      Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  startTime DateTime
  endTime   DateTime
  price     Decimal    // Giá vé cơ bản cho suất chiếu này
  bookings  Booking[]
  seatHolds SeatHold[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Booking {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  showtimeId     String
  showtime       Showtime      @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  totalPrice     Decimal
  discountAmount Decimal?      @default(0)
  voucherCode    String?
  paymentMethod  String?       @default("MOMO")
  status         BookingStatus @default(PENDING)
  idempotencyKey String?       @unique
  ticketToken    String?       @unique // Token chữ ký số cho QR Check-in
  isCheckedIn    Boolean       @default(false)
  checkInAt      DateTime?
  bookingSeats   BookingSeat[]
  paymentLogs    PaymentLog[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model BookingSeat {
  id        String   @id @default(uuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seatId    String
  seat      Seat     @relation(fields: [seatId], references: [id], onDelete: Cascade)
  price     Decimal  // Giá thực tế lúc bán

  @@unique([bookingId, seatId])
}

model SeatHold {
  id         String   @id @default(uuid())
  showtimeId String
  showtime   Showtime @relation(fields: [showtimeId], references: [id], onDelete: Cascade)
  seatId     String
  seat       Seat     @relation(fields: [seatId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  expireAt   DateTime
  
  @@unique([showtimeId, seatId])
}

model Voucher {
  id              String    @id @default(uuid())
  code            String    @unique
  discountPercent Int?      // Giảm %
  discountAmount  Decimal?  // Giảm tiền mặt
  minOrderAmount  Decimal   @default(0)
  maxDiscount     Decimal?
  issueDate       DateTime  @default(now()) // Ngày phát hành
  expireAt        DateTime  // Ngày hết hạn
  usageLimit      Int       @default(100)
  usedCount       Int       @default(0)
  isActive        Boolean   @default(true)
  userId          String?   // Gán cho user cụ thể nếu được tặng
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model PaymentLog {
  id             String   @id @default(uuid())
  bookingId      String?
  booking        Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId        String?
  amount         Decimal?
  currency       String   @default("VND")
  paymentMethod  String?
  statusBefore   String?
  statusAfter    String?
  ipAddress      String?
  userAgent      String?
  signature      String?
  isVerified     Boolean  @default(false)
  rawPayload     String?  @db.Text
  checksum       String?
  createdAt      DateTime @default(now())
}

model IdempotencyRecord {
  id           String   @id @default(uuid())
  key          String   @unique
  userId       String?
  path         String?
  responseBody String?  @db.Text
  statusCode   Int      @default(200)
  createdAt    DateTime @default(now())
  expireAt     DateTime
}

model PaymentSetting {
  id                String   @id @default(uuid())
  momoQrUrl         String?
  vietQrUrl         String?
  zaloPayQrUrl      String?
  bankAccountName   String?
  bankAccountNumber String?
  bankName          String?
  updatedAt         DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?  // null dành cho Admin broadcast hoặc user cụ thể
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO") // BOOKING, APPROVED, CANCELLED, VOUCHER, SYSTEM
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model EmailSetting {
  id           String   @id @default(uuid())
  smtpEmail    String?  // Gmail gửi thư
  smtpPassword String?  // App Password Google
  senderName   String?  @default("CINEVERSE Cinema")
  adminEmail   String?  @default("admin@cineverse.vn")
  updatedAt    DateTime @updatedAt
}

model FooterSetting {
  id              String   @id @default(uuid())
  termsOfService  String?  @db.Text
  privacyPolicy   String?  @db.Text
  customerCare    String?  @db.Text
  aboutUs         String?  @db.Text
  hotline         String?  @default("1900 8888")
  email           String?  @default("support@cineverse.vn")
  socialFacebook  String?  @default("https://facebook.com/cineverse")
  socialYoutube   String?  @default("https://youtube.com/cineverse")
  socialZalo      String?  @default("https://zalo.me/cineverse")
  cancellationCutoffHours Int @default(12)
  updatedAt       DateTime @updatedAt
}
